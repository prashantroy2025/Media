# ==============================================================================
# Nova Autopilot Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure with your credentials:
#   cp .env.example .env
#
# SECURITY NOTICE:
# - The .env file contains real credentials and is strictly ignored by Git.
# - NEVER commit .env, private keys, or credentials/ to version control.
# - This template (.env.example) contains placeholders only and is safe to commit.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Core Runtime
# ------------------------------------------------------------------------------
CONTENT_LANGUAGE=en
NOVA_HOST=127.0.0.1
NOVA_PORT=8765
NOVA_ENV=development
NOVA_DB_PATH=data/nova.db

# ------------------------------------------------------------------------------
# 2. LLM Providers (Local Ollama is default, cloud APIs optional)
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
GROQ_API_KEY=your_groq_api_key_here
# Comma-separated keys supported for automatic failover and pool load balancing
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GOOGLE_API_KEY=your_google_api_key_here
HF_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------------------
# 3. Google Cloud & Service Account Configuration
# ------------------------------------------------------------------------------
# Path to local Google Cloud service account JSON or OAuth client secrets
# Place actual JSON keys in ./credentials/ directory (ignored by Git)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# ------------------------------------------------------------------------------
# 4. Science, Space & Research APIs
# ------------------------------------------------------------------------------
# Free NASA API key from https://api.nasa.gov (DEMO_KEY works for light testing)
NASA_API_KEY=DEMO_KEY
# Contact email for EDGAR / arXiv API compliance headers
CONTACT_EMAIL=your_email@example.com

# ------------------------------------------------------------------------------
# 5. Media & Stock Footage Providers (Free tiers available)
# ------------------------------------------------------------------------------
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here
SMITHSONIAN_API_KEY=your_smithsonian_api_key_here
EUROPEANA_API_KEY=your_europeana_api_key_here
FREESOUND_API_KEY=your_freesound_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
COVERR_API_KEY=your_coverr_api_key_here
JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# ------------------------------------------------------------------------------
# 6. YouTube Data API v3 & Publishing
# ------------------------------------------------------------------------------
# YouTube Data API Key for trend collection & channel tracking
YOUTUBE_API_KEY=your_youtube_api_key_here
# YouTube OAuth 2.0 desktop credentials for publishing
YOUTUBE_CLIENT_SECRET_FILE=./credentials/client_secret.json
YOUTUBE_TOKEN_FILE=./data/tokens/youtube_token.json

# ------------------------------------------------------------------------------
# 7. Instagram Graph API (Reels Publishing)
# ------------------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
# ------------------------------------------------------------------------------
# 8. AI Video Generation Providers (Optional, fallback to stock footage)
# ------------------------------------------------------------------------------
AI_VIDEO_PROVIDER=auto # auto, google_veo, runway, luma, kling, mock
RUNWAY_API_KEY=your_runway_api_key_here
LUMA_API_KEY=your_luma_api_key_here
KLING_API_KEY=your_kling_api_key_here
