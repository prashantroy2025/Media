# Nova Autopilot Environment Configuration v2.0
# Copy this file to .env and fill in your keys as needed.

# ==============================================================================
# Content & Language Strategy
# ==============================================================================
CONTENT_LANGUAGE=en # "en" (default) or "hinglish"

# ==============================================================================
# LLM Providers (Local Ollama is default, hosted keys optional)
# ==============================================================================
OLLAMA_HOST=http://127.0.0.1:11434
# Optional Groq API Key (Free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Optional Google Gemini API Key (Free tier: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Hugging Face token if using HF Inference API fallback
HF_TOKEN=your_huggingface_token_here

# ==============================================================================
# Science & Space APIs
# ==============================================================================
# NASA API Key (Free key at https://api.nasa.gov, default is DEMO_KEY)
NASA_API_KEY=DEMO_KEY

# ==============================================================================
# Stock Footage & Media APIs (Optional! Keyless NASA & Wikimedia are built-in)
# ==============================================================================
# Pexels API Key (Get free key at https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here
# Pixabay API Key (Get free key at https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_api_key_here

# ==============================================================================
# YouTube Data API v3 (Desktop App OAuth)
# ==============================================================================
# Place your Google Cloud OAuth 2.0 Client Secret JSON in this path:
YOUTUBE_CLIENT_SECRET_FILE=credentials/client_secret.json
YOUTUBE_TOKEN_FILE=data/tokens/youtube_token.json

# ==============================================================================
# Instagram Graph API (Reels Publishing)
# ==============================================================================
# Meta Graph API Long-Lived User or Page Access Token
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
# Instagram Business or Creator Account ID
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
# Cloudflare quick tunnel for hosting video temporarily
CLOUDFLARE_TUNNEL_ENABLED=true

# ==============================================================================
# Review UI & Server
# ==============================================================================
NOVA_HOST=127.0.0.1
NOVA_PORT=8765
NOVA_ENV=development
